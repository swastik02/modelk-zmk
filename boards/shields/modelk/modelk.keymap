#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

#define DEFAULT 0
#define BT      1

/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                //  -------------------------------------------------------------------------------------------------------------------------
                //  | ESC   |       | F1    | F2    | F3    | F4    |   | F5    | F6    | F7    | F8    |   | F9    | F10   | F11   | F12   |       |PRT SCR| SLCK  |PAU_BRK|
                    &kp ESC         &kp F1  &kp F2   &kp F3  &kp F4      &kp F5  &kp F6  &kp F7  &kp F8      &kp F9  &kp F10 &kp F11  &kp F12       &kp PSCRN &kp SLCK &kp PAUSE_BREAK
                //  |  `    |  1    |  2    |  3    |  4    |  5    |  6    |  7    |  8    |  9    |  0    |  -    |  =    |   BKSP        |       |INSERT | HOME  |PAGE_UP|       |BL_NUM | KP /  | KP *  | KP -  |
                    &kp GRAVE &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0 &kp MINUS  &kp EQUAL  &kp BSPC         &kp INS &kp HOME &kp PG_UP      &kp KP_NUM &kp KP_DIVIDE &kp KP_MULTIPLY &kp KP_MINUS
                //  |    TAB    |  Q    |  W    |  E    |  R    |  T    |  Y    |  U    |  I    |  O    |  P    |   [   |   ]   |   "|\"    |       |DELETE |  END  |PAGE_DW|       | KP_N7 | KP_N8 | KP_N9 | KP +  |
                    &kp TAB     &kp Q      &kp W  &kp E  &kp R   &kp T   &kp Y   &kp U   &kp I   &kp O   &kp P   &kp LBKT &kp RBKT &kp BSLH         &kp DEL   &kp END &kp PG_DN     &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_PLUS
                //  | CAPS        |   A   |   S   |   D   |   F   |   G   |   H   |   J   |   K   |   L   |   ;   |   '   |      ENTER      |                                       | KP_N4 | KP_N5 | KP_N6 |(KP +) |
                    &kp CAPS        &kp A  &kp S   &kp D   &kp F   &kp G   &kp H   &kp J   &kp K   &kp L   &kp SEMI &kp SQT   &kp ENTER                                             &kp KP_N4 &kp KP_N5 &kp KP_N6
                //  |   LSHIFT        |   Z   |   X   |   C   |   V   |   B   |   N   |   M   |   ,   |   .   |   /   |        RSHIFT       |               |  UP   |               | KP_N1 | KP_N2 | KP_N3 | KPENT |
                    &kp LSHIFT         &kp Z   &kp X   &kp C   &kp V   &kp B   &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH   &kp RSHIFT                     &kp UP                 &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_ENTER
                //  |   CTRL    |       |    ALT    |                        SPACE                          |   ALTGR   |       |   CTRL    |       | LEFT  | DOWN  | RIGHT |       |     KP_N0     | KP .  |(KPENT)|
		        	&kp LCTRL              &kp LALT              &kp SPACE                                   &lt BT RALT         &kp RCTRL          &kp LEFT &kp DOWN &kp RIGHT      &kp KP_N0 &kp KP_DOT
                //  -------------------------------------------------------------------------------------------------------------------------
            >;
        };

        bt_layer {
            bindings = <
                //  -------------------------------------------------------------------------------------------------------------------------
                //  | ESC   |       | F1    | F2    | F3    | F4    |   | F5    | F6    | F7    | F8    |   | F9    | F10   | F11   | F12   |       |PRT SCR| SLCK  |PAU_BRK|
                    &bt BT_CLR_ALL   &none   &none  &none   &sys_reset  &bootloader &none &none &none         &none &ext_power EP_OFF &ext_power EP_ON  &none     &none &none &none
                //  |  `    |  1    |  2    |  3    |  4    |  5    |  6    |  7    |  8    |  9    |  0    |  -    |  =    |   BKSP        |       |INSERT | HOME  |PAGE_UP|       |BL_NUM | KP /  | KP *  | KP -  |
                    &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none                   &none   &none   &none           &none   &none   &none   &none
                //  |    TAB    |  Q    |  W    |  E    |  R    |  T    |  Y    |  U    |  I    |  O    |  P    |   [   |   ]   |   "|\"    |       |DELETE |  END  |PAGE_DW|       | KP_N7 | KP_N8 | KP_N9 | KP +  |
                    &none       &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none               &none   &none   &none           &none   &none   &none   &none
                //  | CAPS        |   A   |   S   |   D   |   F   |   G   |   H   |   J   |   K   |   L   |   ;   |   '   |      ENTER      |                                       | KP_N4 | KP_N5 | KP_N6 |(KP +) |
                    &none         &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none                                                     &none   &none   &none
                //  |   LSHIFT        |   Z   |   X   |   C   |   V   |   B   |   N   |   M   |   ,   |   .   |   /   |        RSHIFT       |               |  UP   |               | KP_N1 | KP_N2 | KP_N3 | KPENT |
                    &none             &none   &none   &none   &none   &none   &none   &none   &none   &none   &none    &none                                &none                   &none   &none   &none   &none
                //  |   CTRL    |       |    ALT    |                        SPACE                          |   ALTGR   |       |   CTRL    |       | LEFT  | DOWN  | RIGHT |       |     KP_N0     | KP .  |(KPENT)|
		        	&none               &none              &none                                             &none               &none              &none   &none   &none           &none           &none
                //  -------------------------------------------------------------------------------------------------------------------------
            >;
        };
    };
};
